{
  "swagger": "2.0",
  "info": {
    "title": "Azure AI Content Understanding GCC custom connector",
    "description": "Unverified starter custom connector for Azure AI Content Understanding. Verify the current analyzer contract and API version against Microsoft documentation and the target resource; this definition does not assert compatibility.",
    "version": "1.0.0"
  },
  "host": "{resourceName}.cognitiveservices.azure.us",
  "basePath": "/contentunderstanding",
  "schemes": ["https"],
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "x-ms-parameterized-host": {
    "hostTemplate": "{resourceName}.cognitiveservices.azure.us",
    "useSchemePrefix": true,
    "parameters": [
      {
        "name": "resourceName",
        "in": "path",
        "required": true,
        "type": "string",
        "x-ms-summary": "Content Understanding resource name",
        "x-ms-visibility": "important"
      }
    ]
  },
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "name": "Ocp-Apim-Subscription-Key",
      "in": "header"
    }
  },
  "security": [{ "apiKey": [] }],
  "paths": {
    "/analyzers/{analyzerId}:analyze": {
      "post": {
        "summary": "Analyze content",
        "operationId": "AnalyzeContent",
        "parameters": [
          {
            "name": "analyzerId",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Analyzer ID"
          },
          {
            "name": "api-version",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Required. Supply an API version verified against the current service contract and target resource; no default is asserted by this starter definition.",
            "x-ms-summary": "Verified API version"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "type": "object" }
          }
        ],
        "responses": {
          "202": {
            "description": "Analysis accepted",
            "schema": { "type": "object" }
          },
          "200": {
            "description": "Analysis result",
            "schema": { "type": "object" }
          }
        }
      }
    }
  }
}
